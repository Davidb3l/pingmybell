{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PingMyBell",
  "version": "0.0.1",
  "identifier": "app.pingmybell.desktop",
  "build": {
    "beforeDevCommand": "bun run build && bun run sidecar",
    "beforeBuildCommand": "bun run build && bun run sidecar",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "board",
        "title": "PingMyBell",
        "width": 760,
        "height": 500,
        "visible": false
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "PingMyBell Overlay",
        "width": 200,
        "height": 40,
        "acceptFirstMouse": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focusable": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/pingmybell-shim"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
