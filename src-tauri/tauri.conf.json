{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PingMyBell",
  "version": "0.0.1",
  "identifier": "app.pingmybell.desktop",
  "build": {
    "beforeDevCommand": "bun run build && bun run sidecar",
    "beforeBuildCommand": "bun run build && bun run sidecar",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "board",
        "title": "PingMyBell",
        "width": 760,
        "height": 500,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/pingmybell-shim"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
